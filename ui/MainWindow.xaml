<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TitleBar x:Name="AppTitleBar" Title="CFUnpacker" Subtitle="熔萤FluorescentLava" />
<Page
    x:Name="MainPage" Grid.Row="1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="24,16,24,16">
                <StackPanel
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="游戏版本" />
                        <ComboBox
                            x:Name="GameComboBox"
                            HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="自动识别" />
                            <ComboBoxItem Content="保卫萝卜" />
                            <ComboBoxItem Content="保卫萝卜2" />
                            <ComboBoxItem Content="保卫萝卜3" />
                            <ComboBoxItem Content="保卫萝卜4" />
                            <ComboBoxItem Content="保卫萝卜阿波之旅" />
                            <ComboBox.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2C2C2C" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>

                    <Border
                        x:Name="ApkDropTarget"
                        Padding="12"
                        AllowDrop="True"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                VerticalAlignment="Center"
                                Symbol="Document" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="拖入 APK" />
                                <TextBlock
                                    x:Name="DropHintText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="拖入 .apk / .apks / .xapk（支持 .apk.1）" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="输入文件夹" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="InputFolderTextBox"
                                PlaceholderText="选择包含 APK 的文件夹" />
                            <Button
                                x:Name="BrowseInputFolderButton"
                                Grid.Column="1"
                                AutomationProperties.Name="选择输入文件夹"
                                ToolTipService.ToolTip="选择输入文件夹">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="输出文件夹" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="OutputPathTextBox"
                                PlaceholderText="选择资源输出文件夹" />
                            <Button
                                x:Name="BrowseOutputButton"
                                Grid.Column="1"
                                AutomationProperties.Name="选择输出文件夹"
                                ToolTipService.ToolTip="选择输出文件夹">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="OverwriteCheckBox" Content="覆盖同名输出目录" />

                    <InfoBar
                        x:Name="ResultInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="32,12,32,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ShowLogButton"
                    AutomationProperties.Name="运行日志"
                    ToolTipService.ToolTip="运行日志">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Document" />
                        <TextBlock Text="运行日志" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="OpenOutputButton"
                    Grid.Column="2"
                    AutomationProperties.Name="打开输出"
                    IsEnabled="False"
                    ToolTipService.ToolTip="打开输出">
                    <SymbolIcon Symbol="OpenLocal" />
                </Button>
                <Button
                    x:Name="StartButton"
                    Grid.Column="3"
                    AutomationProperties.Name="开始解包"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon
                            Foreground="#FFFFFFFF"
                            Symbol="Play" />
                        <TextBlock
                            Foreground="#FFFFFFFF"
                            Text="开始解包" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ContentDialog
            x:Name="ProgressDialog"
            PrimaryButtonText="取消"
            Title="正在解包">
            <StackPanel
                Width="360"
                Spacing="12">
                <TextBlock
                    x:Name="StatusTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="正在准备…" />
                <ProgressBar
                    x:Name="UnpackProgressBar"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />
                <TextBlock
                    x:Name="ProgressTextBlock"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="0%" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="ProfileMismatchDialog"
            CloseButtonText="取消"
            DefaultButton="Primary">
            <TextBlock
                x:Name="ProfileMismatchText"
                MaxWidth="420"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="LogDialog"
            CloseButtonText="关闭"
            DefaultButton="Close"
            Title="运行日志">
            <TextBox
                x:Name="LogTextBox"
                MinWidth="520"
                MinHeight="280"
                MaxHeight="420"
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </ContentDialog>
    </Grid>
</Page>

</Grid>
