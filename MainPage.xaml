<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CFUnpacker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="24,16,24,16">
                <StackPanel
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="游戏版本" />
                        <ComboBox
                            x:Name="GameComboBox"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Border
                        x:Name="ApkDropTarget"
                        Padding="12"
                        AllowDrop="True"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                VerticalAlignment="Center"
                                Symbol="Document" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="拖入 APK" />
                                <TextBlock
                                    x:Name="DropHintText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="将 .apk 文件拖到此处" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="输入文件夹" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="InputFolderTextBox"
                                PlaceholderText="选择包含 APK 的文件夹" />
                            <Button
                                x:Name="BrowseInputFolderButton"
                                Grid.Column="1"
                                AutomationProperties.Name="选择输入文件夹"
                                Click="BrowseInputFolderButton_Click"
                                ToolTipService.ToolTip="选择输入文件夹">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="输出文件夹" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="OutputPathTextBox"
                                PlaceholderText="选择资源输出文件夹" />
                            <Button
                                x:Name="BrowseOutputButton"
                                Grid.Column="1"
                                AutomationProperties.Name="选择输出文件夹"
                                Click="BrowseOutputButton_Click"
                                ToolTipService.ToolTip="选择输出文件夹">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <InfoBar
                        x:Name="ResultInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="32,12,32,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ShowLogButton"
                    AutomationProperties.Name="运行日志"
                    Click="ShowLogButton_Click"
                    ToolTipService.ToolTip="运行日志">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Document" />
                        <TextBlock Text="运行日志" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="OpenOutputButton"
                    Grid.Column="2"
                    AutomationProperties.Name="打开输出"
                    Click="OpenOutputButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="打开输出">
                    <SymbolIcon Symbol="OpenLocal" />
                </Button>
                <Button
                    x:Name="StartButton"
                    Grid.Column="3"
                    AutomationProperties.Name="开始解包"
                    Click="StartButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="开始解包" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ContentDialog
            x:Name="ProgressDialog"
            PrimaryButtonClick="ProgressDialog_PrimaryButtonClick"
            PrimaryButtonText="取消"
            Title="正在解包">
            <StackPanel
                Width="360"
                Spacing="12">
                <TextBlock
                    x:Name="StatusTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="正在准备…" />
                <ProgressBar
                    x:Name="UnpackProgressBar"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />
                <TextBlock
                    x:Name="ProgressTextBlock"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="0%" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="ProfileMismatchDialog"
            CloseButtonText="取消"
            DefaultButton="Primary">
            <TextBlock
                x:Name="ProfileMismatchText"
                MaxWidth="420"
                TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog
            x:Name="LogDialog"
            CloseButtonText="关闭"
            DefaultButton="Close"
            Title="运行日志">
            <TextBox
                x:Name="LogTextBox"
                MinWidth="520"
                MinHeight="280"
                MaxHeight="420"
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </ContentDialog>
    </Grid>
</Page>
