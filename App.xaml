<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CarrotUnpacker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CarrotUnpacker">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Keep the WinUI surfaces intact, but make the product accent deterministic. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#FF228B4B</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF319A5A</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF228B4B</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF176235</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF1D7A41</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF176235</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF124C2B</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF228B4B" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF1D7A41" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF176235" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF9DCCAE" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF228B4B" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#FF176235" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush" Color="#33228B4B" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="#66228B4B" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush" Color="#99228B4B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
